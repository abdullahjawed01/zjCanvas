# ZJCanvas Environment Configuration Example
# Copy or reference these values when setting up build.sh

DOMAIN="zjcanvas.com"
WWW_DOMAIN="www.zjcanvas.com"
WEB_ROOT="/var/www/zjcanvas.com"
CERTBOT_EMAIL="your-email@example.com"

# Admin backend (server/) config lives separately — see server/.env.example.
# ADMIN_PASSWORD can also be exported when running build.sh the first time:
#   sudo ADMIN_PASSWORD='a-strong-password' ./build.sh
