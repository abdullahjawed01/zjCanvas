# Copy to server/.env only if you want to control these yourself.
# Normally you don't need to — the server generates this file automatically
# on first boot (random SESSION_SECRET, random admin password printed once
# to the console) and rewrites it whenever the password is changed from
# the admin Settings tab.

# Port the Node process listens on (nginx proxies /admin and /api/ to it).
PORT=3000

# development | production — set to production on the VPS (build.sh does
# this for you). Controls secure cookies and a couple of log lines.
NODE_ENV=production

# Optional: set a starting password instead of letting one be generated.
# Only read once, on the very first boot with no ADMIN_PASSWORD_HASH yet —
# it is hashed immediately and never written to disk in plain text.
# ADMIN_PASSWORD=change-me-before-first-boot

# Auto-generated — do not set by hand.
# SESSION_SECRET=
# ADMIN_PASSWORD_HASH=
